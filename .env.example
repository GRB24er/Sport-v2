# BETGENIUS AI - Environment Configuration

# MongoDB
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/betgenius?retryWrites=true&w=majority

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-secret-key-generate-with-openssl-rand-base64-32

# Admin Credentials (first admin account)
ADMIN_EMAIL=admin@betgenius.ai
ADMIN_PHONE=+1234567890
ADMIN_PASSWORD=admin123
ADMIN_NAME=Super Admin

# Cloudinary (for image uploads)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Pricing (USD)
SIGNUP_FEE_USD=20
REFERRAL_BONUS_USD=2

# Google Gemini AI (for real AI predictions)
GEMINI_API_KEY=your-gemini-api-key-from-aistudio.google.com

# Football Data API (football-data.org)
# Sign up at https://www.football-data.org/ — free tier covers EPL, La Liga, Serie A, Bundesliga, UCL
FOOTBALL_API_KEY=your-football-data-org-api-key

# Cron Secret (protects automated prediction endpoint)
# Generate with: openssl rand -hex 32
CRON_SECRET=your-cron-secret-key

# Crypto Wallets (configure in admin settings or here)
# USDT_TRC20_ADDRESS=your-trc20-usdt-wallet-address
# USDT_ERC20_ADDRESS=your-erc20-usdt-wallet-address
# BTC_ADDRESS=your-bitcoin-wallet-address

# Card Payments
# STRIPE_PUBLIC_KEY=
# STRIPE_SECRET_KEY=
# PAYSTACK_PUBLIC_KEY=
# PAYSTACK_SECRET_KEY=

# Optional: Twilio for SMS
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=
