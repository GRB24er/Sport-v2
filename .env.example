# VIRTUALBET - Environment Configuration

# MongoDB
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/virtualbet?retryWrites=true&w=majority

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-secret-key-generate-with-openssl-rand-base64-32

# Admin Credentials (first admin account)
ADMIN_PHONE=0200000000
ADMIN_PASSWORD=admin123
ADMIN_NAME=Super Admin

# Cloudinary (for image uploads)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Currency Config
GHS_TO_USD_RATE=0.077
SIGNUP_FEE_GHS=250
REFERRAL_BONUS_GHS=20

# Google Gemini AI (for real AI predictions)
GEMINI_API_KEY=your-gemini-api-key-from-aistudio.google.com

# Crypto Wallets (configure in admin settings or here)
# USDT_TRC20_ADDRESS=your-trc20-usdt-wallet-address
# USDT_ERC20_ADDRESS=your-erc20-usdt-wallet-address
# BTC_ADDRESS=your-bitcoin-wallet-address

# Mobile Money Merchant Number
# MERCHANT_MOMO_NUMBER=your-merchant-number
# MERCHANT_MOMO_NAME=your-merchant-name

# Optional: Twilio for SMS
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=
